# Every text file is stored with LF; checkouts on Windows keep LF too, so Docker, CI and the laptop see the same bytes.
* text=auto eol=lf

*.pth binary
*.npz binary
*.npy binary
*.gz binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
